<% layout("/layouts/boilerplate") %>

<div class="container py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5">
                    <!-- Success Icon -->
                    <div class="text-center mb-4">
                        <div
                            class="d-inline-flex align-items-center justify-content-center
                                   bg-success text-white rounded-circle shadow-sm"
                            style="width: 72px; height: 72px; font-size: 32px;"
                        >
                            ✓
                        </div>

                    </div>
                    <!-- Header -->
                    <div class="text-center">
                        <h2 class="fw-bold mb-2">
                            Payment Successful!
                        </h2>
                        <p class="text-muted mb-0">
                            Your booking has been confirmed.
                        </p>
                    </div>
                    <!-- Success Message -->
                    <div class="bg-light rounded-4 p-3 p-md-4 mt-4 mb-4">
                        <div class="d-flex align-items-center gap-3">
                            <div
                                class="d-flex align-items-center justify-content-center
                                       bg-white rounded-circle flex-shrink-0"
                                style="width: 42px; height: 42px;"
                            >
                                ✓
                            </div>
                            <div>
                                <small class="text-muted d-block">
                                    BOOKING CONFIRMED
                                </small>
                                <strong>
                                    Your payment was received successfully.
                                </strong>
                            </div>
                        </div>
                    </div>
                    <!-- Listing -->
                    <div class="mb-4">
                        <h4 class="fw-bold mb-1 text-break">
                            <%= listing.title %>
                        </h4>
                        <p class="text-muted mb-0 text-break">
                            📍 <%= listing.location %>,
                            <%= listing.country %>
                        </p>
                    </div>
                    <!-- Stay Details -->
                    <h6 class="fw-bold text-uppercase text-muted mb-3">
                        Stay Details
                    </h6>
                    <div class="row g-3">
                        <!-- Check-in -->
                        <div class="col-12 col-sm-6">
                            <div class="border rounded-3 p-3 h-100">
                                <small class="text-muted d-block mb-1">
                                    CHECK-IN
                                </small>
                                <strong class="d-block text-break">
                                    <%= booking.checkIn.toDateString() %>
                                </strong>
                            </div>
                        </div>
                        <!-- Check-out -->
                        <div class="col-12 col-sm-6">
                            <div class="border rounded-3 p-3 h-100">
                                <small class="text-muted d-block mb-1">
                                    CHECK-OUT
                                </small>
                                <strong class="d-block text-break">
                                    <%= booking.checkOut.toDateString() %>
                                </strong>
                            </div>
                        </div>
                        <!-- Guests -->
                        <div class="col-12">
                            <div class="border rounded-3 p-3">
                                <div class="d-flex justify-content-between
                                            align-items-center gap-3">
                                    <span class="text-muted">
                                        Guests
                                    </span>
                                    <strong class="text-nowrap">
                                        <%= booking.guests %>
                                        <%= booking.guests == 1
                                            ? "Guest"
                                            : "Guests"
                                        %>
                                    </strong>
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr class="my-4">
                    <!-- Total -->
                    <div
                        class="d-flex justify-content-between
                               align-items-center gap-3"
                    >
                        <div>
                            <span class="text-muted d-block">
                                Total Paid
                            </span>
                            <small class="text-muted">
                                Payment completed
                            </small>
                        </div>
                        <strong
                            class="fs-3 text-nowrap text-end"
                        >
                            ₹<%= booking.totalPrice.toLocaleString("en-IN") %>
                        </strong>
                    </div>
                    <!-- Back Button -->
                    <a
                        href="/listings"
                        class="btn btn-dark btn-lg w-100 mt-4
                               py-2 rounded-3 fw-semibold"
                    >
                        Back to Listings
                    </a>
                    <!-- Footer Message -->
                    <p class="text-center text-muted small mt-3 mb-0">
                        Thank you for booking with WanderLust.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>