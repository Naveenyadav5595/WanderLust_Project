
<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
   <div class="col-8 offset-2">
    <h3> Edit your Listing</h3>
    <form method="POST" action="/listings/<%=listing._id%>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
            <lable for="title" class="form-label">Title</lable>
            <input name="listing[title]" value="<%=listing.title%>" type="text" class="form-control" required/>
            <div class="invalid-feedback">Title should be valid!</div>
        </div>

        <div class="mb-3">
            <lable for="description" class="form-label">Description</lable>
            <textarea name="listing[description]" class="form-control" required><%=listing.description%></textarea>
            <div class="invalid-feedback">Please enter a short description!</div>
        </div>

        <div class="row">
         <div class="mb-3 col-md-4">
            <lable for="price" class="form-label">Price</lable>
            <input name="listing[price]" value="<%=listing.price%>" type="number" class="form-control" required/>
            <div class="invalid-feedback">Price should be valid!</div>
         </div>
        
         <div class="mb-3 col-md-8">
            <lable for="country" class="form-label">Country</lable>
            <input name="listing[country]" value="<%=listing.country%>" type="text" class="form-control" required/>
            <div class="invalid-feedback">Country name should be valid!</div>
         </div>
        </div>
         <!-- for image preview -->
        <div class="mb-3">
          <p>Previous Listing Image </p> 
          <img src="<%= originalUrl %>">
        </div>

        <div class="mb-3">
            <lable for="image" class="form-label">Upload new Image</lable>
            <input name="listing[image]" type="file" class="form-control"/>
        </div>

        <div class="mb-3">
            <lable for="location" class="form-label">Location</lable>
            <input name="listing[location]" value="<%=listing.location%>" type="text" class="form-control" required/>
            <div class="invalid-feedback">Location should be valid!</div>
        </div>
        <div class="mb-3">
          <lable for="location" class="form-label">Category</lable>
          <div class="d-flex flex-wrap gap-3">
            <div class="form-check">
               <input class="form-check-input" type="checkbox" name="listing[category]" value="Trendings" <%= listing.category.includes("Trendings") ? "checked" : "" %>>>
               <label class="form-check-label"> Trendings </label>
            </div>
            <div class="form-check">
               <input class="form-check-input" type="checkbox" name="listing[category]" value="Rooms" <%= listing.category.includes("Rooms") ? "checked" : "" %>> >
               <label class="form-check-label"> Rooms </label>
            </div>
            <div class="form-check">
               <input class="form-check-input" type="checkbox" name="listing[category]" value="Iconic Cities" <%= listing.category.includes("Iconic Cities") ? "checked" : "" %>>>
               <label class="form-check-label"> Iconic cities </label>
            </div>
            <div class="form-check">
               <input class="form-check-input" type="checkbox" name="listing[category]" value="Beachs" <%= listing.category.includes("Beachs") ? "checked" : "" %>> >
               <label class="form-check-label"> Beachs </label>
            </div>
            <div class="form-check">
               <input class="form-check-input" type="checkbox" name="listing[category]" value="Mountains" <%= listing.category.includes("Mountains") ? "checked" : "" %>>>
               <label class="form-check-label"> Mountains </label>
            </div>
            <div class="form-check">
               <input class="form-check-input" type="checkbox" name="listing[category]" value="Farms" <%= listing.category.includes("Farms") ? "checked" : "" %>>>
               <label class="form-check-label"> Farms </label>
            </div>
            <div class="form-check">
               <input class="form-check-input" type="checkbox" name="listing[category]" value="Arctics" <%= listing.category.includes("Arctics") ? "checked" : "" %>>>
               <label class="form-check-label"> Arctics </label>
            </div>
            <div class="form-check">
               <input class="form-check-input" type="checkbox" name="listing[category]" value="Pools" <%= listing.category.includes("Pools") ? "checked" : "" %>>>
               <label class="form-check-label"> Pools </label>
            </div>
            <div class="form-check">
               <input class="form-check-input" type="checkbox" name="listing[category]" value="Campings" <%= listing.category.includes("Campings") ? "checked" : "" %>>>
               <label class="form-check-label"> Campings </label>
            </div>
            <div class="form-check">
               <input class="form-check-input" type="checkbox" name="listing[category]" value="Castles" <%= listing.category.includes("Castles") ? "checked" : "" %>>>
               <label class="form-check-label"> Castles </label>
            </div>
          </div>
        </div>

        <button class="btn btn-dark edit-btn mt-3">Edit</button>
        
    </form>
   </div>
</div>
