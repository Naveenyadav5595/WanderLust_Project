<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
  <h3 class="col-6 offset-3"><%=listing.title%></h3>
  <div class="col-6 offset-3">
      <form method="POST" action="/listings/<%=listing._id%>/checkAvailability" novalidate class="needs-validation">
            <!-- // check in -->
            <div class="mb-3">
                <label for="checkIn" class="form-label">Enter Check In date</label>
                <input type="date" id="checkIn" name="checkIn" class="form-control" required >
                <div class="invalid-feedback">Date should be valid!</div>
            </div>
               <!-- // check out -->
            <div class="mb-3">
                <label for="checkOut" class="form-label">Enter Check Out date</label>
                <input type="date" id="checkOut" name="checkOut" class="form-control" required >
                <div class="invalid-feedback">Date should be valid!</div>
             </div>
             <!-- guests -->
            <div class="mb-3">
                <label for="guests" class="form-label">Enter no of guests</label>
                <input type="number" id="guests" name="guests" class="form-control" min="1" required >
                <div class="invalid-feedback">Date should be valid!</div>
            </div>
            <!-- to submit data -->
            <button type="submit" class="btn btn-dark " >
                Check Availability
            </button>
      </form>
  </div>
</div>
