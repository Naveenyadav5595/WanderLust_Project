<% layout("/layouts/boilerplate") %>
<div class="container py-4 py-md-5">
    <div class="row g-4 g-lg-5">
        <!-- LEFT: Booking information -->
        <div class="col-12 col-lg-7">
            <h2 class="fw-bold mb-2">Booking Summary</h2>
            <p class="text-muted mb-4">
                Review your booking details before continuing.
            </p>
            <!-- Listing -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                <div class="row g-0">
                    <!-- Image -->
                    <!-- <div class="col-12 col-sm-4">
                        <img
                            src="<%= listing.image.url %>"
                            alt="<%= listing.title %>"
                            class="w-100 h-100"
                            style="object-fit: cover; min-height: 180px;"
                        >
                    </div> -->
                    <!-- Listing information -->
                    <div class="col-12 col-sm-8">
                        <div class="p-3 p-md-4">
                            <h3 class="fw-bold fs-4">
                                <%= listing.title %>
                            </h3>
                            <p class="text-muted mb-0">
                                📍 <%= listing.location %>,
                                <%= listing.country %>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Stay Details -->
            <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4">
                <h4 class="fw-bold mb-4">
                    Stay Details
                </h4>
                <div class="row g-3">
                    <!-- Check in -->
                    <div class="col-12 col-sm-6">
                        <div class="bg-light rounded-3 p-3">
                            <small class="text-muted d-block">
                                CHECK-IN
                            </small>
                            <strong>
                                <%= checkIn.toDateString() %>
                            </strong>
                        </div>
                    </div>
                    <!-- Check out -->
                    <div class="col-12 col-sm-6">
                        <div class="bg-light rounded-3 p-3">
                            <small class="text-muted d-block">
                                CHECK-OUT
                            </small>
                            <strong>
                                <%= checkOut.toDateString() %>
                            </strong>
                        </div>
                    </div>
                    <!-- Guests -->
                    <div class="col-12 col-sm-6">
                        <div class="bg-light rounded-3 p-3">
                            <small class="text-muted d-block">
                                GUESTS
                            </small>
                            <strong>
                                <%= guests %>
                                <%= guests == 1 ? "Guest" : "Guests" %>
                            </strong>
                        </div>
                    </div>
                    <!-- Nights -->
                    <div class="col-12 col-sm-6">
                        <div class="bg-light rounded-3 p-3">
                            <small class="text-muted d-block">
                                DURATION
                            </small>
                            <strong>
                                <%= nights %>
                                <%= nights == 1 ? "Night" : "Nights" %>
                            </strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- RIGHT: Price -->
       <div class="col-12 col-lg-5">
           <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4">
                <h4 class="fw-bold mb-3">
                   Price Details
                </h4>
                <hr>
              <!-- Price per night -->
               <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <span class="text-muted">
                      ₹<%= listing.price.toLocaleString("en-IN") %>
                       × <%= nights %> nights
                    </span>
                    <span class="fw-medium text-end">
                       ₹<%= (listing.price * nights).toLocaleString("en-IN") %>
                    </span>
                </div>
               <!-- Guests -->
               <div class="d-flex justify-content-between mb-3">
                   <span class="text-muted">
                        Guests
                    </span>
                    <span>
                        <%= guests %>
                    </span>
                </div>
                <hr>

                <!-- Total -->
               <div class="d-flex justify-content-between align-items-center gap-3">
                   <strong class="fs-5">
                      Total
                   </strong>
                    <strong class="fs-5 text-end">
                      ₹<%= (listing.price * nights).toLocaleString("en-IN") %>
                    </strong>
                </div>
                <form action="/bookings" method="POST">
                    <input
                       type="hidden"
                       name="listingId"
                       value="<%= listing._id %>"
                    >
                    <input
                       type="hidden"
                       name="checkIn"
                       value="<%= checkIn.toISOString() %>"
                    >
                    <input
                        type="hidden"
                        name="checkOut"
                        value="<%= checkOut.toISOString() %>"
                    >
                    <input
                       type="hidden"
                       name="guests"
                       value="<%= guests %>"
                    >
                    <button
                       type="submit"
                       class="btn btn-dark w-100 mt-4"
                    >
                        Continue to Payment
                    </button>

                </form>
               <p class="text-center text-muted small mt-3 mb-0">
                      Secure payment • No hidden charges
                </p>
            </div>
        </div>
    </div>
</div>